<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>所有文章</h1>
  <%= link_to "新增文章", new_blog_path, class: "btn btn-primary" %>
</div>

<% if @blogs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>標題</th>
          <th>內容預覽</th>
          <th>作者ID</th>
          <th>建立時間</th>
          <th width="200">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @blogs.each do |blog| %>
          <tr>
            <td>
              <%= link_to blog.title, blog_path(blog), class: "text-decoration-none fw-bold" %>
            </td>
            <td>
              <%= truncate(blog.content, length: 50) %>
            </td>
            <td>
              <span class="badge bg-secondary"><%= blog.user_id %></span>
            </td>
            <td>
              <small class="text-muted">
                <%= blog.created_at.strftime("%Y/%m/%d %H:%M") %>
              </small>
            </td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <%= link_to "檢視", blog_path(blog), class: "btn btn-outline-primary btn-sm" %>
                <%= link_to "編輯", edit_blog_path(blog), class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "刪除", blog_path(blog), 
                    method: :delete, 
                    class: "btn btn-outline-danger btn-sm",
                    data: { 
                      confirm: "確定要刪除這篇文章嗎？",
                      turbo_method: :delete 
                    } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-5">
    <div class="mb-4">
      <i class="fas fa-blog fa-4x text-muted"></i>
    </div>
    <h3 class="text-muted mb-3">還沒有任何文章</h3>
    <p class="text-muted mb-4">開始寫下你的第一篇文章吧！</p>
    <%= link_to "新增第一篇文章", new_blog_path, class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
