<div class="row">
  <div class="col-lg-8 mx-auto">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h1 class="card-title mb-0"><%= @blog.title %></h1>
        <div class="btn-group" role="group">
          <%= link_to "編輯", edit_blog_path(@blog), class: "btn btn-outline-primary btn-sm" %>
          <%= link_to "刪除", blog_path(@blog), 
              method: :delete, 
              class: "btn btn-outline-danger btn-sm",
              data: { 
                confirm: "確定要刪除這篇文章嗎？",
                turbo_method: :delete 
              } %>
        </div>
      </div>
      
      <div class="card-body">
        <div class="mb-3">
          <small class="text-muted">
            作者: <span class="badge bg-secondary"><%= @blog.user.account %></span> |
            建立時間: <%= @blog.created_at.strftime("%Y年%m月%d日 %H:%M") %> |
            更新時間: <%= @blog.updated_at.strftime("%Y年%m月%d日 %H:%M") %>
          </small>
        </div>
        
        <div class="content">
          <%= simple_format(@blog.content, class: "lh-lg") %>
        </div>
      </div>
      
      <div class="card-footer">
        <%= link_to "← 回到文章列表", blogs_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>