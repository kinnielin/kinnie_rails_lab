<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kinnie Rails Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Bootstrap CSS %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# 頂部 Menu Bar %>
    <div data-turbo="false">
      <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
          <%= link_to "Kinnie的 Ruby On Rails 開發實驗", root_path, class: "navbar-brand" %>
          
          <%# Toggle button for mobile %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <%# Menu Items %>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
              <li class="nav-item dropdown">
                <a class="nav-link" href="<%=profile_index_path%>" role="button" aria-expanded="false">
                  首頁
                </a>
             
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  部落格
                </a>
                <ul class="dropdown-menu">
                  <li><%= link_to "所有文章", blogs_path, class: "dropdown-item" %></li>
                  <% if logged_in? %>
                    <li><%= link_to "新增文章", new_blog_path, class: "dropdown-item" %></li>
                  <% end %>
                </ul>
              </li>
            </ul>
            
            <%# 右側登入狀態顯示 %>
            <div class="navbar-nav ms-auto">
              <% if logged_in? %>
                <span class="navbar-text me-3">
                  <i class="fas fa-user"></i> 歡迎, <%= current_user.account %>
                </span>
                <%= link_to "登出", logout_path, 
                    class: "btn btn-outline-light btn-sm",
                    data: { 
                      turbo_method: :delete,
                      confirm: "確定要登出嗎？" 
                    } %>
              <% else %>
                <%= link_to "登入", login_path, class: "btn btn-outline-light btn-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    </div>

    <%# Flash messages %>
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <main class="container mt-4">
      <%= yield %>
    </main>

    <%# Bootstrap JavaScript %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    
    <%# 確保 Bootstrap 正常工作 - 最簡化方法 %>
    <script>
      // 延遲初始化，確保 DOM 完全載入
      setTimeout(function() {
        // 強制重新初始化所有 Bootstrap dropdown
        document.querySelectorAll('.dropdown-toggle').forEach(function(element) {
          if (!element.hasAttribute('data-bs-initialized')) {
            new bootstrap.Dropdown(element);
            element.setAttribute('data-bs-initialized', 'true');
          }
        });
      }, 100);
    </script>
  </body>
</html>
